# Biến môi trường service này cần. Chép thành .env (cùng thư mục pom.xml) rồi điền giá trị; .env không commit.
# Có repo infra nằm cạnh (../infra) thì không cần file này: service đọc luôn ../infra/.env do infra/scripts/init-env.sh tạo.
# Giá trị phải KHỚP với service ở đầu kia (ghi bên cạnh từng biến).

# Khoá API merchant và secret ký webhook của MockPay (giống mock-payment-gateway)
MOCKPAY_API_KEY=
MOCKPAY_WEBHOOK_SECRET=

# Khoá Ed25519 ký QR vé, base64 (PKCS#8 DER cho private, X.509 DER cho public). Chỉ core dùng (ADR-008)
QR_PRIVATE_KEY=
QR_PUBLIC_KEY=

# Khoá của core khi gọi /internal/** của identity-service (giống INTERNAL_API_KEY_CORE bên identity-service)
INTERNAL_API_KEY_CORE=
# Khoá notification-service dùng khi gọi /internal/** của core (giống bên notification-service)
INTERNAL_API_KEY_NOTIFICATION=

# Khoá HMAC ký vé vào cửa của phòng chờ, tối thiểu 32 ký tự (ADR-027). Mọi instance core dùng CÙNG giá trị
WAITING_ROOM_SECRET=
